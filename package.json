{
  "name": "@viniaraujo68/plinth",
  "version": "0.1.0",
  "description": "A personal Svelte 5 design system: theme, application shell, interface primitives, routing metadata, a fetch wrapper and locale-aware formatters.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viniaraujo68/plinth.git"
  },
  "homepage": "https://viniaraujo68.github.io/plinth",
  "bugs": {
    "url": "https://github.com/viniaraujo68/plinth/issues"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "sveltekit",
    "design-system",
    "component-library",
    "tailwindcss",
    "daisyui"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run prepack",
    "preview": "vite preview",
    "prepare": "svelte-kit sync && svelte-package",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright install chromium && playwright test"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*.e2e.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "svelte": "./dist/theme/index.js"
    },
    "./theme.css": "./dist/theme/theme.css",
    "./attachments": {
      "types": "./dist/attachments/index.d.ts",
      "svelte": "./dist/attachments/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "svelte": "./dist/components/index.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "svelte": "./dist/shell/index.js"
    },
    "./table": {
      "types": "./dist/table/index.d.ts",
      "svelte": "./dist/table/index.js"
    },
    "./toast": {
      "types": "./dist/toast/index.d.ts",
      "svelte": "./dist/toast/index.js"
    },
    "./routing": {
      "types": "./dist/routing.svelte.d.ts",
      "svelte": "./dist/routing.svelte.js"
    },
    "./user": {
      "types": "./dist/user/index.d.ts",
      "svelte": "./dist/user/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./formatters": {
      "types": "./dist/formatters.d.ts",
      "default": "./dist/formatters.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24",
    "@vitest/browser-playwright": "^4.1.8",
    "daisyui": "^5.6.10",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "publint": "^0.3.21",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^2.1.1"
  }
}
